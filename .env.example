# ---- Branding -------------------------------------------------------------
BRAND_NAME=Forries
BRAND_TAGLINE=Collect stamps, earn rewards.
# Public HTTPS address of the app (used in emails, the poster QR code and unsubscribe links)
PUBLIC_URL=https://rewards.forries.co.za
# Link to your privacy policy (shown on the sign-up form)
PRIVACY_URL=

# ---- Server ---------------------------------------------------------------
PORT=3000
# Long random string — signs unsubscribe links. Generate: openssl rand -hex 32
APP_SECRET=
# true in production (HTTPS)
COOKIE_SECURE=false
# true = no email/WhatsApp needed: login codes are shown on screen. NEVER use in production.
DEMO_MODE=false
TZ_NAME=Africa/Johannesburg
DEFAULT_COUNTRY_CODE=27
MAX_STAMPS_PER_SCAN=10
# DB_PATH=./data/loyalty.db

# ---- Email (sign-in codes, birthday emails, campaigns) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=rewards@forries.co.za

# ---- WhatsApp Cloud API (optional) -----------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
# Approved "Authentication" template for sign-in codes (lets members without email sign in by WhatsApp)
WHATSAPP_OTP_TEMPLATE=
# Approved template for the birthday message; {{1}} = first name
WHATSAPP_BIRTHDAY_TEMPLATE=
META_GRAPH_VERSION=v21.0
