# Copy to functions/.env and fill in. Deployed with the functions (`firebase deploy`).
# ---- Branding ---------------------------------------------------------------
BRAND_NAME=Forries
BRAND_TAGLINE=Collect stamps, earn rewards.
# Your public address (custom domain or https://forries-2815d.web.app)
PUBLIC_URL=https://forries-2815d.web.app
PRIVACY_URL=

# ---- Server -----------------------------------------------------------------
# Long random string — signs unsubscribe links. Generate: openssl rand -hex 32
APP_SECRET=
# true = login codes shown on screen instead of emailed. NEVER in production.
DEMO_MODE=false
TZ_NAME=Africa/Johannesburg
DEFAULT_COUNTRY_CODE=27
MAX_STAMPS_PER_SCAN=10
FUNCTION_REGION=africa-south1

# ---- Email (sign-in codes, birthday emails, campaigns) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=rewards@forries.co.za

# ---- WhatsApp Cloud API (optional) --------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_BIRTHDAY_TEMPLATE=
META_GRAPH_VERSION=v21.0
